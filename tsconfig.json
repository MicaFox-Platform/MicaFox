{
  "extends": "@micafox/configs/tsconfig/base.json",
  "compilerOptions": {
    "noEmit": true,
    "customConditions": ["@micafox/source"]
  },
  "include": [
    "*.ts",
    "packages/*/vitest*.config.ts",
    "packages/*/src/**/*.test.ts",
    "packages/*/src/**/*.test-d.ts",
    "examples/*/src/**/*.test.ts",
    "packages/*/test",
    "examples/*/vitest.config.ts",
    "examples/*/tests"
  ]
}
