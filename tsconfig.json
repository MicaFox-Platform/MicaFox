{
  "extends": "@micafox/configs/tsconfig/base.json",
  "compilerOptions": {
    "noEmit": true,
    "customConditions": ["@micafox/source"],
    "jsx": "react-jsx",
    "types": ["node", "@micafox/configs/css-modules"]
  },
  "include": [
    "*.ts",
    "packages/*/vitest*.config.ts",
    "packages/*/src/**/*.test.ts",
    "packages/*/src/**/*.test.tsx",
    "packages/*/src/**/*.test-d.ts",
    "examples/*/src/**/*.test.ts",
    "examples/frameworks/*/src/**/*.test.ts",
    "packages/*/test",
    "examples/*/vitest*.config.ts",
    "examples/frameworks/*/vitest*.config.ts",
    "examples/*/tests",
    "examples/frameworks/*/tests",
    "tools/*/vitest*.config.ts",
    "tools/*/src",
    "tools/*/docker",
    "tools/*/bench",
    "tools/*/test"
  ]
}
