{
  "name": "micafox",
  "version": "0.1.0",
  "private": true,
  "description": "MicaFox runtime platform for Node.js",
  "type": "module",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck && tsc -p .",
    "test": "vitest run",
    "test:build": "pnpm -r test:build",
    "test:pack": "bash .github/scripts/check-packs.sh",
    "test:docker": "vitest run --root tools/testkit --config vitest.docker.config.ts",
    "bench": "node --import tsx tools/testkit/bench/main.ts",
    "test:watch": "vitest --coverage",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint . && bash .github/scripts/check-structure.sh && bash .github/scripts/check-actions.sh && bash .github/scripts/check-licences.sh",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --check",
    "format:fix": "prettier . --write",
    "verify": "pnpm verify:begin && pnpm lint && pnpm format && pnpm build && pnpm typecheck && pnpm test:pack && pnpm test:build && pnpm test:coverage && pnpm verify:mark",
    "verify:begin": "bash .github/scripts/verify-cache.sh begin",
    "verify:mark": "bash .github/scripts/verify-cache.sh mark",
    "verify:brief": "bash .claude/scripts/verify-brief.sh",
    "verify:fix": "pnpm lint:fix && pnpm format:fix",
    "version-packages": "changeset version && bash .github/scripts/sync-sdk-version.sh && pnpm format:fix",
    "docker:up": "docker compose -f examples/compose.yaml up --build",
    "docker:down": "docker compose -f examples/compose.yaml down",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "keywords": [],
  "author": "Artem Horovyi",
  "license": "MIT",
  "packageManager": "pnpm@10.26.2",
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@micafox/configs": "workspace:*",
    "@types/node": "^26.1.2",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.8.0",
    "prettier": "^3.9.6",
    "publint": "^0.3.25",
    "tsx": "^4.23.5",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
