{
  "name": "@micafox/hub-core",
  "version": "0.0.0",
  "private": true,
  "description": "The hub's core: the feature contract, server, web shell, database and access",
  "type": "module",
  "exports": {
    ".": {
      "@micafox/source": "./src/server/index.ts",
      "types": "./dist/server/index.d.ts",
      "default": "./dist/server/index.js"
    },
    "./web": {
      "@micafox/source": "./src/web/index.ts",
      "types": "./dist/web/index.d.ts",
      "default": "./dist/web/index.js"
    },
    "./schema": {
      "@micafox/source": "./src/schema/index.ts",
      "types": "./dist/schema/index.d.ts",
      "default": "./dist/schema/index.js"
    }
  },
  "scripts": {
    "build": "rm -rf ./dist && tsc -b tsconfig.json",
    "typecheck": "tsc -b tsconfig.json"
  },
  "keywords": [],
  "author": "Artem Horovyi",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.17",
    "@fastify/rate-limit": "^11.3.0",
    "@fastify/swagger": "^9.9.5",
    "@micafox/protocol": "workspace:*",
    "@micafox/ui": "workspace:*",
    "fastify": "^5.12.7",
    "kysely": "^0.29.9",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "typebox": "^1.4.7"
  },
  "devDependencies": {
    "@micafox/configs": "workspace:*",
    "@types/pg": "^8.23.1"
  }
}
