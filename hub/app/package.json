{
  "name": "@micafox/hub",
  "version": "0.0.0",
  "private": true,
  "description": "The MicaFox hub app: the hub and basic hub builds, the image, Compose setup and Helm chart",
  "type": "module",
  "imports": {
    "#ee": {
      "micafox-open-core": "./src/ee-stub.ts",
      "default": "./src/ee-stub.ts"
    },
    "#ee/web": {
      "micafox-open-core": "./src/web/ee-stub.ts",
      "default": "./src/web/ee-stub.ts"
    }
  },
  "bin": {
    "micafox-hub": "./dist/server/bin.js"
  },
  "exports": {
    "./cli": "./dist/server/bin.js"
  },
  "scripts": {
    "build": "rm -rf ./dist && tsc -b tsconfig.json && node --import tsx scripts/build.ts",
    "typecheck": "tsc -b tsconfig.json && tsc -p tsconfig.open-core.json",
    "test:build": "vitest run --config vitest.build.config.ts",
    "check-open-core": "node --import tsx scripts/check-open-core.ts",
    "test:open-core": "EE=false pnpm build && pnpm check-open-core"
  },
  "keywords": [],
  "author": "Artem Horovyi",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.17",
    "@micafox/hub-core": "workspace:*",
    "@micafox/hub-debugger": "workspace:*",
    "@micafox/protocol": "workspace:*",
    "@micafox/ui": "workspace:*"
  },
  "devDependencies": {
    "@micafox/configs": "workspace:*",
    "esbuild": "^0.28.2"
  }
}
