{
  "name": "@micafox/frameworks",
  "version": "0.1.0",
  "private": true,
  "description": "Express, NestJS and Next.js apps debugged by the built MicaFox SDK",
  "type": "module",
  "scripts": {
    "build": "pnpm build:nestjs && pnpm build:nextjs",
    "build:nestjs": "nest build --config src/nestjs/nest-cli.json && echo '{ \"type\": \"commonjs\" }' > dist/nestjs/package.json",
    "build:nextjs": "NEXT_TELEMETRY_DISABLED=1 next build src/nextjs",
    "typecheck": "tsc -p src/nestjs/tsconfig.json --noEmit && tsc -p src/nextjs/tsconfig.json --noEmit",
    "test:build": "vitest run --config vitest.build.config.ts"
  },
  "keywords": [],
  "author": "Artem Horovyi",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@micafox/sdk": "workspace:*",
    "@nestjs/common": "^12.5.0",
    "@nestjs/core": "^12.5.0",
    "@nestjs/platform-express": "^12.5.0",
    "express": "^5.3.0",
    "next": "16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@micafox/configs": "workspace:*",
    "@micafox/protocol": "workspace:*",
    "@micafox/testkit": "workspace:*",
    "@nestjs/cli": "^11.0.24",
    "@types/express": "^5.0.6",
    "@types/react": "^19.3.0",
    "typescript": "^6.0.3"
  }
}
