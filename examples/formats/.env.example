# Copy to .env (git ignores it): `cp .env.example .env`. The `start:<app>` scripts read it; the tests never do.
# PORT is not set here: each script has its own default (cjs 3101, esm 3102, tsc-cjs 3103, tsc-esm 3104, bundled 3105);
# set it in the shell to change one: `PORT=4000 pnpm start:cjs`.
MICAFOX_HUB_URL=ws://127.0.0.1:8787/micafox
MICAFOX_SERVICE=formats
MICAFOX_LOG_LEVEL=info
