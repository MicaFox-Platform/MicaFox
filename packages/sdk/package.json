{
  "name": "@micafox/sdk",
  "version": "0.1.1",
  "description": "MicaFox SDK: the debugger and the default hub connector, run inside the host app",
  "type": "module",
  "exports": {
    ".": {
      "@micafox/source": "./src/index.ts",
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    }
  },
  "files": [
    "dist",
    "!dist/**/*.tsbuildinfo"
  ],
  "scripts": {
    "dev": "tsx --conditions=@micafox/source --watch src/index.ts",
    "build": "rm -rf ./dist && tsc -b tsconfig.json tsconfig.cjs.json && echo '{ \"type\": \"commonjs\" }' > dist/cjs/package.json",
    "typecheck": "tsc -b tsconfig.json tsconfig.cjs.json && echo '{ \"type\": \"commonjs\" }' > dist/cjs/package.json",
    "test": "vitest run",
    "test:build": "vitest run --config vitest.build.config.ts"
  },
  "keywords": [],
  "author": "Artem Horovyi",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@micafox/protocol": "workspace:^",
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "@micafox/configs": "workspace:*",
    "@types/ws": "^8.18.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MicaFox-Platform/MicaFox.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://github.com/MicaFox-Platform/MicaFox/tree/main/packages/sdk#readme",
  "bugs": {
    "url": "https://github.com/MicaFox-Platform/MicaFox/issues"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "import": {
          "types": "./dist/esm/index.d.ts",
          "default": "./dist/esm/index.js"
        },
        "require": {
          "types": "./dist/cjs/index.d.ts",
          "default": "./dist/cjs/index.js"
        }
      }
    }
  }
}
