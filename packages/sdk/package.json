{
  "name": "@micafox/sdk",
  "version": "0.1.0",
  "description": "MicaFox SDK: the debugger and the default hub connector, run inside the host app",
  "type": "module",
  "exports": {
    ".": {
      "@micafox/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx --conditions=@micafox/source --watch src/index.ts",
    "build": "rm -rf ./dist && tsc -b",
    "typecheck": "tsc -b",
    "test": "vitest run"
  },
  "keywords": [],
  "author": "Artem Horovyi",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@micafox/protocol": "workspace:*",
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "@micafox/configs": "workspace:*",
    "@types/ws": "^8.18.2"
  }
}
