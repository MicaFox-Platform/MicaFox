{
  "name": "@micafox/protocol",
  "version": "0.1.0",
  "description": "MicaFox protocol: messages, protocol version and the Connector interface",
  "type": "module",
  "exports": {
    ".": {
      "@micafox/source": "./src/index.ts",
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf ./dist && tsc -b tsconfig.json tsconfig.cjs.json && echo '{ \"type\": \"commonjs\" }' > dist/cjs/package.json",
    "typecheck": "tsc -b tsconfig.json tsconfig.cjs.json && echo '{ \"type\": \"commonjs\" }' > dist/cjs/package.json",
    "test": "vitest run",
    "test:build": "vitest run --config vitest.build.config.ts"
  },
  "keywords": [],
  "author": "Artem Horovyi",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@micafox/configs": "workspace:*"
  }
}
